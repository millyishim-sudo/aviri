function refreshBrainrotESP()
	if _G.bjkESPBlocked and _G.bjkESPBlocked() then
		pcall(clearBrainrotESP)
		return
	end

	if not brainrotESPEnabled then
		return
	end

	if not SharedState.AllAnimalsCache then
		return
	end
	-- Show every cached brainrot in every base. A generation filter is only
	-- applied when the user explicitly enters a positive minimum value.
	local minBrainrotESPGen = mainConfig.MinBrainrotESPGen or ""
	local minGen = parseGenInput(minBrainrotESPGen)
	local n = (minGen and minGen > 0) and minGen or -1

	local tbl6 = {}

	for i, v3 in ipairs(SharedState.AllAnimalsCache) do
		if v3 and (tonumber(v3.genValue) or 0) >= n then
			tbl6[v3.uid] = true

			if not tbl2[v3.uid] then
				local v4 = findAdorneeGlobal(v3)

				if v4 then
					local v5 = createBrainrotBillboard(v3)
					v5.Adornee = v4
					v5.Parent = v4
					tbl2[v3.uid] = { bb = v5 }
				end
			end
		end
	end

	for k, v3 in pairs(tbl2) do
		if not tbl6[k] then
			if v3.bb then
				v3.bb:Destroy()
			end

			tbl2[k] = nil
		end
	end
end

