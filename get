function parseMinGen(arg)
	if not arg or type(arg) ~= "string" then
		return 0
	end
	arg = arg:gsub("%s", ""):lower():gsub("/s$", "")
	if arg == "" then
		return 0
	end
	local match, v2 = arg:match("^([%d%.]+)(%a*)$")
	if not match then
		return 0
	end
	local num = tonumber(match)
	if not num or num < 0 then
